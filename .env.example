FIREBASE_PROJECT_ID=
# Cloud Run 等、実行環境に紐づくサービスアカウント(ADC)で認証する場合は
# FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY は未設定のままでよい
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# (default) 以外の名前付きFirestoreデータベースを使う場合のみ指定
FIRESTORE_DATABASE_ID=
ALLOWED_IPS=
# Google ログイン(OAuth)のクライアントID / シークレット
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# セッション Cookie の署名鍵。十分に長いランダム文字列にする
SESSION_SECRET=
# ログインを許可するメールのドメイン(カンマ区切り。例: example.com,example.org)
ALLOWED_EMAIL_DOMAINS=
# 任意: Host を書き換えるプロキシの背後に置く場合に、OAuth のリダイレクト先の基点として使う(例: https://timothy.example.com)
PUBLIC_BASE_URL=
